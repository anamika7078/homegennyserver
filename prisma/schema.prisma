// ── Phase 4 — Liability Pillars 6, 7, 8 ─────────────────────────────────────
// Loose (non-relational) FK columns to placementId/clientId/staffId/actor ids,
// matching the existing convention already used above on Incident itself
// (staffId is the only hard Prisma relation there too) — avoids touching the
// User/ClientProfile/StaffApplicant/Placement models to add back-relation
// arrays for four new one-directional consumers.

model ScopeOfWork {
  id             String    @id @default(uuid()) @db.Uuid
  placementId    String    @map("placement_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  staffId        String    @map("staff_id") @db.Uuid
  content        String
  version        Int       @default(1)
  /// DRAFT | SENT | ACKNOWLEDGED | SUPERSEDED
  status         String    @default("DRAFT") @db.VarChar(20)
  isNonStandard  Boolean   @default(false) @map("is_non_standard")
  bmApprovedBy   String?   @map("bm_approved_by") @db.Uuid
  bmApprovedAt   DateTime? @map("bm_approved_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  amendedBy      String?   @map("amended_by") @db.Uuid
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  /// Points at the prior version this one replaces — set only when a new
  /// version is created to amend an already-ACKNOWLEDGED one, so the
  /// acknowledged version is never edited in place, only superseded.
  supersedesId   String?   @unique @map("supersedes_id") @db.Uuid
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([placementId])
  @@index([clientId])
  @@map("scope_of_work")
}

