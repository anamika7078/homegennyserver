  eventType   String   @map("event_type") @db.VarChar(20)
  actorId     String   @map("actor_id") @db.Uuid
  reason      String?
  notes       String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([staffId])
  @@index([refusalId])
  @@map("right_to_refuse_log")
}

