// Pure append-only EVENT log — same shape as PipelineEvent, deliberately:
// this table gets the hard Phase 2 UPDATE/DELETE trigger, so a BM decision
// can never be a mutation of the RM's original invocation row, only a new
// row referencing it via refusalId. "Current status" is derived by reading
// the latest event for a refusalId, the same way pipeline_stage lives on
// staff_applicants rather than being mutated on pipeline_events itself.
model RightToRefuseLog {
  id          String   @id @default(uuid()) @db.Uuid
  refusalId   String   @map("refusal_id") @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  placementId String?  @map("placement_id") @db.Uuid
