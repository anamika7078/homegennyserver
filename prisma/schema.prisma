  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bonus_records")
}

model ReimbursementRequest {
  id               String              @id @default(uuid()) @db.Uuid
  employeeId       String              @map("employee_id") @db.Uuid
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category         String              @db.VarChar(50)
  amount           Decimal             @db.Decimal(10, 2)
  expenseDate      DateTime            @map("expense_date") @db.Date
  description      String?
  billUrl          String?             @map("bill_url")
  status           ReimbursementStatus @default(PENDING)
  managerApproval  Boolean             @default(false) @map("manager_approval")
  financeApproval  Boolean             @default(false) @map("finance_approval")
  payrollApproval  Boolean             @default(false) @map("payroll_approval")
  rejectionReason  String?             @map("rejection_reason")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("reimbursement_requests")
}

model EmployeeLoan {
  id               String     @id @default(uuid()) @db.Uuid
  employeeId       String     @map("employee_id") @db.Uuid
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanAmount       Decimal    @map("loan_amount") @db.Decimal(10, 2)
  remainingAmount  Decimal    @map("remaining_amount") @db.Decimal(10, 2)
  monthlyEmi       Decimal    @map("monthly_emi") @db.Decimal(10, 2)
  interestRate     Decimal    @default(0) @map("interest_rate") @db.Decimal(5, 2)
  startDate        DateTime   @map("start_date") @db.Date
  status           LoanStatus @default(ACTIVE)
  autoDeduction    Boolean    @default(true) @map("auto_deduction")
  reason           String?
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("employee_loans")
}

model SalaryAdvance {
  id               String     @id @default(uuid()) @db.Uuid
  employeeId       String     @map("employee_id") @db.Uuid
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount           Decimal    @db.Decimal(10, 2)
