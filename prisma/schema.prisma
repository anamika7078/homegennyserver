  @@map("salary_advances")
}

model PayrollProcessingBatch {
  id                 String                @id @default(uuid()) @db.Uuid
  batchNumber        String                @unique @map("batch_number") @db.VarChar(50)
  month              Int
  year               Int
  branchId           String?               @map("branch_id") @db.Uuid
  branch             Branch?               @relation(fields: [branchId], references: [id])
  status             PayrollApprovalStatus @default(DRAFT)
  totalEmployees     Int                   @default(0) @map("total_employees")
  totalGross         Decimal               @default(0) @map("total_gross") @db.Decimal(12, 2)
  totalBonus         Decimal               @default(0) @map("total_bonus") @db.Decimal(12, 2)
  totalReimbursement Decimal               @default(0) @map("total_reimbursement") @db.Decimal(12, 2)
  totalDeductions    Decimal               @default(0) @map("total_deductions") @db.Decimal(12, 2)
  totalNet           Decimal               @default(0) @map("total_net") @db.Decimal(12, 2)
  createdBy          String?               @map("created_by") @db.Uuid
  approvedAt         DateTime?             @map("approved_at") @db.Timestamptz(6)
  lockedAt           DateTime?             @map("locked_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  details            PayrollDetail[]
  approvals          PayrollApprovalWorkflow[]

  @@map("payroll_processing_batches")
}

model PayrollDetail {
  id                  String                 @id @default(uuid()) @db.Uuid
  batchId             String                 @map("batch_id") @db.Uuid
  batch               PayrollProcessingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId          String                 @map("employee_id") @db.Uuid
  employee            Employee               @relation(fields: [employeeId], references: [id])
  workingDays         Decimal                @default(30) @map("working_days") @db.Decimal(4, 1)
  presentDays         Decimal                @default(0) @map("present_days") @db.Decimal(4, 1)
  paidLeaveDays       Decimal                @default(0) @map("paid_leave_days") @db.Decimal(4, 1)
  lwpDays             Decimal                @default(0) @map("lwp_days") @db.Decimal(4, 1)
  basicSalary         Decimal                @default(0) @map("basic_salary") @db.Decimal(10, 2)
  allowances          Json                   @default("{}")
  overtimeAmount      Decimal                @default(0) @map("overtime_amount") @db.Decimal(10, 2)
  bonusAmount         Decimal                @default(0) @map("bonus_amount") @db.Decimal(10, 2)
  reimbursementAmount Decimal                @default(0) @map("reimbursement_amount") @db.Decimal(10, 2)
  grossSalary         Decimal                @default(0) @map("gross_salary") @db.Decimal(10, 2)
  pfDeduction         Decimal                @default(0) @map("pf_deduction") @db.Decimal(10, 2)
  esicDeduction       Decimal                @default(0) @map("esic_deduction") @db.Decimal(10, 2)
  tdsDeduction        Decimal                @default(0) @map("tds_deduction") @db.Decimal(10, 2)
  ptDeduction         Decimal                @default(0) @map("pt_deduction") @db.Decimal(10, 2)
  loanEmiDeduction    Decimal                @default(0) @map("loan_emi_deduction") @db.Decimal(10, 2)
  advanceDeduction    Decimal                @default(0) @map("advance_deduction") @db.Decimal(10, 2)
  lwpDeduction        Decimal                @default(0) @map("lwp_deduction") @db.Decimal(10, 2)
  totalDeduction      Decimal                @default(0) @map("total_deduction") @db.Decimal(10, 2)
  netSalary           Decimal                @default(0) @map("net_salary") @db.Decimal(10, 2)
  paymentStatus       BankTransferStatus     @default(PENDING) @map("payment_status")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  payslip             PayslipDocument?

  @@unique([batchId, employeeId])
  @@map("payroll_details")
}

model PayrollApprovalWorkflow {
  id               String                 @id @default(uuid()) @db.Uuid
  batchId          String                 @map("batch_id") @db.Uuid
  batch            PayrollProcessingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tier             String                 @db.VarChar(50)
  approverRole     String                 @map("approver_role") @db.VarChar(50)
  status           PayrollApprovalStatus  @default(PENDING)
  approvedBy       String?                @map("approved_by") @db.Uuid
  comments         String?
  actionDate       DateTime?              @map("action_date") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("payroll_approval_workflows")
}

model PayslipDocument {
  id               String        @id @default(uuid()) @db.Uuid
  detailId         String        @unique @map("detail_id") @db.Uuid
  detail           PayrollDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)
  employeeId       String        @map("employee_id") @db.Uuid
  employee         Employee      @relation(fields: [employeeId], references: [id])
  payslipNumber    String        @unique @map("payslip_number") @db.VarChar(100)
  pdfUrl           String?       @map("pdf_url")
  qrCodeData       String?       @map("qr_code_data")
  digitalSignature String?       @map("digital_signature")
  generatedAt      DateTime      @default(now()) @map("generated_at") @db.Timestamptz(6)

  @@map("payslip_documents")
}

model BankTransferBatch {
  id               String             @id @default(uuid()) @db.Uuid
  batchId          String             @map("batch_id") @db.Uuid
  format           String             @default("CSV") @db.VarChar(20)
  fileUrl          String?            @map("file_url")
  totalRecords     Int                @default(0) @map("total_records")
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(12, 2)
  status           BankTransferStatus @default(PENDING)
  generatedBy      String?            @map("generated_by") @db.Uuid
  generatedAt      DateTime           @default(now()) @map("generated_at") @db.Timestamptz(6)

  @@map("bank_transfer_batches")
}

model PayrollSetting {
  id               String   @id @default(uuid()) @db.Uuid
  settingKey       String   @unique @map("setting_key") @db.VarChar(100)
  settingValue     Json     @map("setting_value")
  description      String?
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payroll_settings")
}

