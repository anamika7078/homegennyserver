// ── Enterprise Payroll Management System Models ──────────────────────────────

enum SalaryComponentType {
  EARNING
  DEDUCTION
  STATUTORY
}

enum CalculationType {
  FLAT
  PERCENTAGE
  ATTENDANCE_BASED
}

enum PayrollApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  LOCKED
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
}

enum BankTransferStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model SalaryStructure {
  id             String            @id @default(uuid()) @db.Uuid
  templateName   String            @map("template_name") @db.VarChar(150)
  department     String            @db.VarChar(100)
  designation    String            @db.VarChar(100)
  employmentType String            @map("employment_type") @db.VarChar(50)
  basicSalary    Decimal           @map("basic_salary") @db.Decimal(10, 2)
  hra            Decimal           @default(0) @db.Decimal(10, 2)
  specialAllowance Decimal         @default(0) @map("special_allowance") @db.Decimal(10, 2)
  medical        Decimal           @default(0) @db.Decimal(10, 2)
  travel         Decimal           @default(0) @db.Decimal(10, 2)
  internet       Decimal           @default(0) @db.Decimal(10, 2)
  foodAllowance  Decimal           @default(0) @map("food_allowance") @db.Decimal(10, 2)
  bonus          Decimal           @default(0) @db.Decimal(10, 2)
  professionalTax Decimal          @default(0) @map("professional_tax") @db.Decimal(10, 2)
  pf             Decimal           @default(0) @db.Decimal(10, 2)
  esic           Decimal           @default(0) @db.Decimal(10, 2)
  tds            Decimal           @default(0) @db.Decimal(10, 2)
  effectiveDate  DateTime          @default(now()) @map("effective_date") @db.Date
  status         String            @default("ACTIVE") @db.VarChar(20)
  branchId       String?           @map("branch_id") @db.Uuid
  branch         Branch?           @relation(fields: [branchId], references: [id])
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  components       SalaryComponent[]
  employeeProfiles EmployeeSalaryProfile[]

  @@map("salary_structures")
}

model SalaryComponent {
  id                String              @id @default(uuid()) @db.Uuid
  structureId       String              @map("structure_id") @db.Uuid
  structure         SalaryStructure     @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name              String              @db.VarChar(100)
  type              SalaryComponentType @default(EARNING)
  calculationType   CalculationType     @default(FLAT) @map("calculation_type")
  amount            Decimal             @default(0) @db.Decimal(10, 2)
  percentageValue   Decimal?            @map("percentage_value") @db.Decimal(5, 2)
  isTaxable         Boolean             @default(true) @map("is_taxable")
  isMandatory       Boolean             @default(false) @map("is_mandatory")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("salary_components")
}

model EmployeeSalaryProfile {
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @unique @map("employee_id") @db.Uuid
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId       String?          @map("template_id") @db.Uuid
  template         SalaryStructure? @relation(fields: [templateId], references: [id])
  grossSalary      Decimal          @default(0) @map("gross_salary") @db.Decimal(12, 2)
  bankName         String?          @map("bank_name") @db.VarChar(100)
  accountNumber    String?          @map("account_number") @db.VarChar(50)
  ifsc             String?          @db.VarChar(20)
  pan              String?          @db.VarChar(20)
  uan              String?          @db.VarChar(30)
  esicNumber       String?          @map("esic_number") @db.VarChar(30)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("employee_salary_profiles")
}

model SalaryRevision {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousGross    Decimal   @map("previous_gross") @db.Decimal(12, 2)
  newGross         Decimal   @map("new_gross") @db.Decimal(12, 2)
  incrementAmount  Decimal   @map("increment_amount") @db.Decimal(12, 2)
  incrementPercent Decimal   @map("increment_percent") @db.Decimal(5, 2)
  revisionType     String    @default("INCREMENT") @map("revision_type") @db.VarChar(50)
  effectiveDate    DateTime  @map("effective_date") @db.Date
  notes            String?
  approvedBy       String?   @map("approved_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("salary_revisions")
}

model OvertimeRule {
