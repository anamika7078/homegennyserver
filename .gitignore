# Dependency directories
node_modules/
dist/
build/

# Local video-cert storage (VIDEO_STORAGE_MODE=local jugaad — never commit actual uploads)
local-uploads/

# Environment variables
.env
.env.production
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Database snapshots taken before a destructive scratch script runs. They are
# whole tables of real people — Aadhaar numbers, phones, addresses — and exist
# only so a wrong call can be undone locally. Never commit one.
scratch/_wiped_local_*.json
scratch/_deleted_*.json
scratch/_prod_before_*.json
